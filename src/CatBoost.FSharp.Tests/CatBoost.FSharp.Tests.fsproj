<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="TestHelpers.fs" />
        <Compile Include="ApiTests.fs" />
        <Compile Include="CatBoostCatBoostNetTests.fs" />
        <Compile Include="MireclCatBoostTests.fs" />
        <Compile Include="CatBoostTutorialsTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Deedle" Version="8.1.0" />
        <PackageReference Include="Faqt" Version="6.0.0" />
        <PackageReference Include="FSharp.Stats" Version="0.6.0" />
        <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="..\FsCatBoost.Tests\example\**\*" Link="example\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="..\FsCatBoost.Tests\testbed\**\*" Link="testbed\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="..\FsCatBoost.Tests\tutorials\**\*" Link="tutorials\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\CatBoost.FSharp\CatBoost.FSharp.fsproj" />
    </ItemGroup>

</Project>
